# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional, dev/admin only: personal access token (sbp_...) used to configure Supabase Auth
# (SMTP, email templates, redirect URLs) through the Management API. Never used by the app at runtime.
SUPABASE_ACCESS_TOKEN=
# Secret key (sb_secret_...), server only. Bypasses RLS: used by the public pay page
# and for writes to stripe_accounts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Sender for all emails. Must be on a domain verified in Resend
# (onboarding@resend.dev works for testing, but only delivers to your own Resend account email).
EMAIL_FROM="Invoice Generator <onboarding@resend.dev>"

# Stripe (platform account, Connect enabled). sk_test_... in development.
STRIPE_SECRET_KEY=
# Signing secret of the Connect webhook endpoint. Added with the webhook.
# STRIPE_WEBHOOK_SECRET=

# Absolute base URL of the app, for email links and Stripe redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
